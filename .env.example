PORT=3000
CURRENCY=INR

# Set to "production" when the site is live (turns off demo payments, enables caching).
NODE_ENV=development

# First admin login (used only when the database has no users yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# ---------- Payment gateways ----------
# Fill in one or both. Choose the default (and per-event overrides) in Admin → Payments.
# With no gateway keys, development uses demo payments (no real money).

# Razorpay (Dashboard > Account & Settings > API Keys).
# Use rzp_test_ keys first, then switch to rzp_live_ keys when going live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://YOUR-DOMAIN/api/webhooks/razorpay, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# Cashfree (Merchant Dashboard > Developers > API Keys). Use sandbox keys with CASHFREE_ENV=sandbox first.
# Dashboard > Developers > Webhooks: URL https://YOUR-DOMAIN/api/webhooks/cashfree (version 2023-08-01, Payment Success).
# Cashfree signs webhooks with the secret key, so no separate webhook secret is needed.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ---------- SMS for customer OTP login (smsgw.in) ----------
# Without these, development shows the OTP on screen / in the server log (never in production).
SMSGW_USERNAME=
SMSGW_PASSWORD=
# 6-character DLT sender ID (header), e.g. EVTPAS
SMSGW_SENDER=
# DLT Principal Entity ID and the Content Template ID of your approved OTP template
SMSGW_PE_ID=
SMSGW_TEMPLATE_ID=
# Must match your DLT-approved template EXACTLY; {otp} is replaced with the code.
SMS_OTP_TEMPLATE=Your OTP for ticket booking is {otp}. It is valid for 5 minutes. Do not share it with anyone.
# Set to 91 only if your SMS account expects numbers as 91XXXXXXXXXX
SMSGW_COUNTRY_CODE=

# Booking confirmation SMS (sent when a ticket is booked). Uses the same smsgw.in account as above,
# with its own DLT template. The text must match the approved template EXACTLY.
# Placeholders: {name} {event} {time} {code} {link}
SMSGW_BOOKING_TEMPLATE_ID=
SMS_BOOKING_TEMPLATE=Dear {name}, your booking for {event} on {time} is confirmed. Ticket ID: {code}. View your ticket: {link}

# ---------- WhatsApp booking confirmation ----------
# Sent when a ticket is booked, using the approved "ticket_booked" template:
# header image = ticket QR code, body = event name, timings, ticket ID.
# The QR image is fetched by WhatsApp from PUBLIC_URL, so PUBLIC_URL must be a public https address.
WHATSAPP_API_URL=https://api.wapost.click/api/meta/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BOOKING_TEMPLATE=ticket_booked
WHATSAPP_TEMPLATE_LANG=en
# Country code put in front of the 10-digit mobile number
WHATSAPP_COUNTRY_CODE=91

# Public https address of the site, e.g. https://tickets.example.com
# (used for the gateway return page and webhooks; required in production).
PUBLIC_URL=

# Behind a reverse proxy (Caddy / Nginx / a host's load balancer) set this to 1 so real client IPs are used.
TRUST_PROXY=
# Number of server processes: 1 (default), a number, or "auto" for one per CPU core.
WEB_CONCURRENCY=1
# Optional: keep the database and uploaded images somewhere else (default ./data). Back this folder up.
DATA_DIR=
