# Caddy: free automatic HTTPS (Let's Encrypt) in front of the app.
# Replace tickets.example.com with your domain, then:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

tickets.example.com {
	# Event images are resized in the browser; 10 MB leaves headroom.
	request_body {
		max_size 10MB
	}

	reverse_proxy 127.0.0.1:3000

	log {
		output file /var/log/caddy/eventpass.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# Optional: send www to the main domain.
# www.tickets.example.com {
# 	redir https://tickets.example.com{uri} permanent
# }
